    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/merge": "^6.12.2",
    "@eslint/js": "^10.0.1",
    "@fontsource/audiowide": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/chewy": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/righteous": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@mantine/core": "^9.7.1",
