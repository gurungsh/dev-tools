{
  "name": "dev-tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && SINGLE_FILE=1 vite build --outDir dist-single",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "check:offline": "node scripts/check-offline.mjs dist",
    "build:app": "vite build --outDir dist-app --emptyOutDir",
    "desktop": "npm run build:app && electron .",
    "package": "node scripts/package.mjs",
    "packs": "node scripts/build-packs.mjs"
  },
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
